<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Dictionary\**" />
    <Compile Remove="Generic\**" />
    <Compile Remove="Linq\**" />
    <Compile Remove="Struct\**" />
    <EmbeddedResource Remove="Dictionary\**" />
    <EmbeddedResource Remove="Generic\**" />
    <EmbeddedResource Remove="Linq\**" />
    <EmbeddedResource Remove="Struct\**" />
    <None Remove="Dictionary\**" />
    <None Remove="Generic\**" />
    <None Remove="Linq\**" />
    <None Remove="Struct\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Polymorphism\Parent.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.24.1-preview.1" />
  </ItemGroup>

</Project>
